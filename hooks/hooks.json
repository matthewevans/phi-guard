{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/prompt.mjs"],
            "timeout": 20,
            "onFailure": "block",
            "statusMessage": "phi-guard: scanning prompt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/bash-output.mjs"],
            "timeout": 20,
            "onFailure": "block",
            "statusMessage": "phi-guard: scanning output"
          }
        ]
      }
    ]
  }
}
