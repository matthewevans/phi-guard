{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/codex-prompt.mjs\" || { echo 'phi-guard: prompt hook failed' >&2; exit 2; }",
            "timeout": 20,
            "statusMessage": "phi-guard: scanning prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/codex-pre-tool-use.mjs\" || { echo 'phi-guard: command wrapper failed' >&2; exit 2; }",
            "timeout": 20,
            "statusMessage": "phi-guard: preparing output scan"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/codex-post-tool-use.mjs\" || { echo 'phi-guard: output hook failed' >&2; exit 2; }",
            "timeout": 20,
            "statusMessage": "phi-guard: scanning output"
          }
        ]
      }
    ]
  }
}
