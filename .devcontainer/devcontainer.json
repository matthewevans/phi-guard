{
  "name": "phi-guard (Claude Code + Codex)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "TZ": "${localEnv:TZ:America/Los_Angeles}",
      "PHI_GUARD_GUARDRAIL_ID": "${localEnv:PHI_GUARD_GUARDRAIL_ID}",
      "PHI_GUARD_GUARDRAIL_VERSION": "${localEnv:PHI_GUARD_GUARDRAIL_VERSION}",
      "PHI_GUARD_AWS_REGION": "${localEnv:PHI_GUARD_AWS_REGION}",
      "PHI_GUARD_AWS_PROFILE": "${localEnv:PHI_GUARD_AWS_PROFILE:phi-guard}"
    }
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--hostname=phi-guard-sandbox"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "node",
  "initializeCommand": "mkdir -p \"$HOME/.aws\" && touch \"$HOME/.npmrc\"",
  "mounts": [
    "source=phi-guard-claude-config,target=/home/node/.claude,type=volume",
    "source=phi-guard-codex-config,target=/home/node/.codex,type=volume",
    "source=${localEnv:HOME}/.aws,target=/home/node/.aws,type=bind,readonly",
    "source=${localEnv:HOME}/.npmrc,target=/home/node/.npmrc,type=bind,readonly"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "PHI_GUARD_FIREWALL": "${localEnv:PHI_GUARD_FIREWALL:web}",
    "PHI_GUARD_EXTRA_HOSTS": "${localEnv:PHI_GUARD_EXTRA_HOSTS:}"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postStartCommand": "if [ \"$PHI_GUARD_FIREWALL\" = off ]; then echo 'phi-guard: egress firewall disabled (PHI_GUARD_FIREWALL=off)'; else sudo /usr/local/bin/init-firewall.sh \"$PHI_GUARD_FIREWALL\" \"$PHI_GUARD_EXTRA_HOSTS\"; fi",
  "waitFor": "postStartCommand"
}
